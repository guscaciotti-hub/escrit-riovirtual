# ==== Anthropic ====
# Chave da API da Anthropic. Obrigatória apenas para chat 1:1 e reuniões (Fases 2 e 3).
# O mapa e a movimentação (Fase 1) funcionam sem ela.
ANTHROPIC_API_KEY=

# ==== Server ====
PORT=3001
# Caminho do arquivo SQLite (relativo à raiz do server)
DATABASE_URL=./data/office.db
# Origem permitida para CORS/Socket.io (client Vite)
CLIENT_ORIGIN=http://localhost:5173

# ==== Multi-tenant (Fase 4) ====
# No MVP single-user o middleware de auth retorna este usuário/org do seed.
DEFAULT_ORG_SLUG=evoluze

# ==== Controle de custo dos modelos ====
# Modelos usados pelo motor de agentes (podem ser sobrescritos por agente no banco).
MODEL_DEBATE=claude-haiku-4-5
MODEL_REASONING=claude-sonnet-4-6

# ==== Client (Vite) ====
# URL do backend para o client. Prefixo VITE_ é obrigatório para exposição no browser.
VITE_SERVER_URL=http://localhost:3001
